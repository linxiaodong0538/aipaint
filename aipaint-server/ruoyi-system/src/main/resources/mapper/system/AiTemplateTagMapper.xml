<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AiTemplateTagMapper">

    <resultMap type="AiTemplateTag" id="AiTemplateTagResult">
        <id property="tagId" column="tag_id" />
        <result property="tagName" column="tag_name" />
        <result property="groupCode" column="group_code" />
        <result property="sort" column="sort" />
        <result property="status" column="status" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectTagVo">
        select tag_id, tag_name, group_code, sort, status, create_by, create_time, update_by, update_time, remark
        from ai_template_tag
    </sql>

    <select id="selectTagList" parameterType="AiTemplateTag" resultMap="AiTemplateTagResult">
        <include refid="selectTagVo" />
        <where>
            <if test="tagName != null and tagName != ''">
                AND tag_name like concat('%', #{tagName}, '%')
            </if>
            <if test="groupCode != null and groupCode != ''">
                AND group_code = #{groupCode}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by sort asc, tag_id asc
    </select>

    <select id="selectTagAll" resultMap="AiTemplateTagResult">
        <include refid="selectTagVo" />
        order by group_code asc, sort asc, tag_id asc
    </select>

    <select id="selectEnabledTagList" resultMap="AiTemplateTagResult">
        <include refid="selectTagVo" />
        where status = '0'
        order by group_code asc, sort asc, tag_id asc
    </select>

    <select id="selectTagById" parameterType="Long" resultMap="AiTemplateTagResult">
        <include refid="selectTagVo" />
        where tag_id = #{tagId}
    </select>

    <insert id="insertTag" parameterType="AiTemplateTag" useGeneratedKeys="true" keyProperty="tagId">
        insert into ai_template_tag(
            <if test="tagName != null and tagName != ''">tag_name,</if>
            <if test="groupCode != null and groupCode != ''">group_code,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="tagName != null and tagName != ''">#{tagName},</if>
            <if test="groupCode != null and groupCode != ''">#{groupCode},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateTag" parameterType="AiTemplateTag">
        update ai_template_tag
        <set>
            <if test="tagName != null and tagName != ''">tag_name = #{tagName},</if>
            <if test="groupCode != null and groupCode != ''">group_code = #{groupCode},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where tag_id = #{tagId}
    </update>

    <delete id="deleteTagByIds" parameterType="Long">
        delete from ai_template_tag where tag_id in
        <foreach collection="array" item="tagId" open="(" separator="," close=")">
            #{tagId}
        </foreach>
    </delete>
</mapper>
