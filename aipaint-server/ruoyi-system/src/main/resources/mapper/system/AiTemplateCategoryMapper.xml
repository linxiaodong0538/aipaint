<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AiTemplateCategoryMapper">

    <resultMap type="AiTemplateCategory" id="AiTemplateCategoryResult">
        <id property="categoryId" column="category_id" />
        <result property="categoryName" column="category_name" />
        <result property="categoryCode" column="category_code" />
        <result property="sort" column="sort" />
        <result property="status" column="status" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectCategoryVo">
        select category_id, category_name, category_code, sort, status, create_by, create_time, update_by, update_time, remark
        from ai_template_category
    </sql>

    <select id="selectCategoryList" parameterType="AiTemplateCategory" resultMap="AiTemplateCategoryResult">
        <include refid="selectCategoryVo" />
        <where>
            <if test="categoryName != null and categoryName != ''">
                AND category_name like concat('%', #{categoryName}, '%')
            </if>
            <if test="categoryCode != null and categoryCode != ''">
                AND category_code like concat('%', #{categoryCode}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by sort asc, category_id asc
    </select>

    <select id="selectCategoryAll" resultMap="AiTemplateCategoryResult">
        <include refid="selectCategoryVo" />
        order by sort asc, category_id asc
    </select>

    <select id="selectEnabledCategoryList" resultMap="AiTemplateCategoryResult">
        <include refid="selectCategoryVo" />
        where status = '0'
        order by sort asc, category_id asc
    </select>

    <select id="selectCategoryById" parameterType="Long" resultMap="AiTemplateCategoryResult">
        <include refid="selectCategoryVo" />
        where category_id = #{categoryId}
    </select>

    <select id="selectCategoryByCode" parameterType="String" resultMap="AiTemplateCategoryResult">
        <include refid="selectCategoryVo" />
        where category_code = #{categoryCode}
    </select>

    <insert id="insertCategory" parameterType="AiTemplateCategory" useGeneratedKeys="true" keyProperty="categoryId">
        insert into ai_template_category(
            <if test="categoryName != null and categoryName != ''">category_name,</if>
            <if test="categoryCode != null and categoryCode != ''">category_code,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="categoryName != null and categoryName != ''">#{categoryName},</if>
            <if test="categoryCode != null and categoryCode != ''">#{categoryCode},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateCategory" parameterType="AiTemplateCategory">
        update ai_template_category
        <set>
            <if test="categoryName != null and categoryName != ''">category_name = #{categoryName},</if>
            <if test="categoryCode != null and categoryCode != ''">category_code = #{categoryCode},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where category_id = #{categoryId}
    </update>

    <delete id="deleteCategoryByIds" parameterType="Long">
        delete from ai_template_category where category_id in
        <foreach collection="array" item="categoryId" open="(" separator="," close=")">
            #{categoryId}
        </foreach>
    </delete>
</mapper>
