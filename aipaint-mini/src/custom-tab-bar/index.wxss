.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  height: calc(146rpx + env(safe-area-inset-bottom));
  padding: 10rpx 34rpx calc(10rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 28rpx rgba(0, 0, 0, 0.06);
}

.tabbar__item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.tabbar__inner {
  display: flex;
  width: 140rpx;
  height: 116rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  transition: background-color 120ms linear;
}

.tabbar__item--active .tabbar__inner {
  width: 112rpx;
  background: #000000;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
}

.tabbar__icon {
  display: block;
  width: 48rpx;
  height: 48rpx;
}

.tabbar__icon--active {
  margin-top: -48rpx;
}

.tabbar__icon--hidden {
  opacity: 0;
}

.tabbar__text {
  display: block;
  margin-top: 10rpx;
  color: #4c4546;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
}

.tabbar__item--active .tabbar__text {
  color: #ffffff;
}
